[Unit]
Description=hubd queue-repl ssh tunnel (NATed node -> build-host zenoh router)
After=network-online.target
Wants=network-online.target

[Service]
# AmbientCapabilities=CAP_NET_BIND_SERVICE
Type=simple
# Forward this node's localhost:7449 to build-host's hubd-queue-router (127.0.0.1:7449)
# over ssh. zenoh traffic then rides the encrypted ssh stream — no plaintext zenoh on
# the public internet. Requires: the peer authorized the tunnel_key pubkey, and
# %h/.ssh/tunnel_key on this node.
ExecStart=/usr/bin/ssh -N -L 7449:127.0.0.1:7449 -i %h/.ssh/tunnel_key -o StrictHostKeyChecking=no -o ServerAliveInterval=25 -o ExitOnForwardFailure=yes root@203.0.113.10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
