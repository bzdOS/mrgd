# BUS-scope matrix-hs on fedora — the second process (SCOPES.md interlock 4:
# one process per scope; the HOME homeserver at /opt/matrix-hs is untouched).
# Holds a bus replica + runs hub_replic against /root/.hubd. No queues bridge
# (the hubd-queue-repl residue on Buildhost is the owner\x27s pending decision).
[Unit]
Description=matrix-hs BUS-scope node (hub replication over the bus mesh)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/opt/matrix-hs-bus/matrix-hs-bus.env
ExecStart=/opt/matrix-hs-bus/matrix-hs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
