# BUS-scope matrix-hs on offsite — the second process (SCOPES.md interlock 4:
# one process per scope; the HOME homeserver at <home-root> is untouched).
# Holds a bus replica + runs hub_replic against %h/<hub-dir>. No queues bridge
# (the hubd-queue-repl residue on build-host is the owner's pending decision).
# TEMPLATE: substitute the deployment's own roots below before installing —
# <bus-root> is this unit's install root, <home-root> the home-scoped one.
[Unit]
Description=matrix-hs BUS-scope node (hub replication over the bus mesh)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=<bus-root>/matrix-hs-bus.env
ExecStart=<bus-root>/matrix-hs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
