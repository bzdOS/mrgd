[Unit]
Description=Zenoh carrier tunnel to guest-b (ssh -R 7449 -> local hubd-queue-router)
After=network-online.target hubd-queue-router.service
Wants=network-online.target
# East-west carrier for the guest-b mesh node (docs/TOPOLOGY.md 3e). Same shape as
# mesh-tunnel-guest-a.service: the remote node dials its own 127.0.0.1:7449, which
# this forward lands on build-host's hubd-queue-router. -L 18452 is the CS-API of
# the guest-b node for local poking. The OLD pre-scope matrix-hs on guest-b (ports
# 8448/7448, server_name localhost) is unrelated and untouched.

[Service]
EnvironmentFile=/etc/fleet/hosts.env
Type=simple
ExecStart=/usr/bin/ssh -N -R 7449:127.0.0.1:7449 -L 18452:127.0.0.1:8452 -i ${BSDOS_SSH_KEY} -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes -o ServerAliveInterval=25 -o ServerAliveCountMax=3 freebsd@${BSDOS_GUEST_B_IP}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
