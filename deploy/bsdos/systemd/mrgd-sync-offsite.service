[Unit]
Description=Refresh the off-site /srv/app copy on offsite (git pull over reverse tunnel)
After=network-online.target
Wants=network-online.target
# The repo history exists in two places (AGENTS.md): build-host's /srv/app and the
# worktree clone on offsite. Until now the refresh was manual after each commit.
# Pull is a no-op when nothing changed; safe to run unattended.

[Service]
EnvironmentFile=/etc/fleet/hosts.env
Type=oneshot
# offsite pulls from root@${BSDOS_HOST_IP}:/srv/app using its own key, already
# authorized. -n and explicit redirects so nothing hangs the unit.
ExecStart=/usr/bin/ssh -n -o BatchMode=yes -o ConnectTimeout=15 offsite "git -C /srv/app pull </dev/null 2>&1"
TimeoutStartSec=120
