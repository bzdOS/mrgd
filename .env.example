# ── matrix-hs runtime configuration template ───────────────────────────────
# Copy to `.env` (or export in your systemd unit / shell) and edit values.
# Lines show: VAR=example  # required? | default | purpose
#
#   REQUIRED  — server will not function correctly without a deliberate value
#   OPTIONAL  — has a safe default (shown)
#   CLUSTER   — only used with `--features cluster`
#
# Build the cluster binary:  cargo build --features cluster
# Build the single-node bin: cargo build

# ── Core (always) ──────────────────────────────────────────────────────────
# Listen address for the Matrix CS-API. 127.0.0.1:8448 is fine behind a reverse
# proxy; use 0.0.0.0:8448 to expose directly (ensure a firewall).
MATRIX_HS_LISTEN=127.0.0.1:8448   # OPTIONAL, default 127.0.0.1:8448

# The server_name half of every user_id (@user:SERVER_NAME). MUST match the
# hostname clients connect to. Changing it after users exist invalidates identities.
MATRIX_HS_SERVER_NAME=localhost   # OPTIONAL, default localhost (change for real use)

# HMAC secret for signing access tokens. REQUIRED for stable sessions across
# restarts: if unset, a random secret is generated per start, which logs out
# every user on each restart. Generate with: openssl rand -hex 32
MATRIX_HS_TOKEN_SECRET=           # REQUIRED (recommended)

# ── Registration & auth ────────────────────────────────────────────────────
# If set, every /register must echo it in body.registration_secret — gates
# account creation. If unset, registration is open (dev default).
MATRIX_HS_REGISTRATION_SHARED_SECRET=   # OPTIONAL, default unset (open)

# Public base URL reported to clients in well-known / media links. Set when
# behind a domain, e.g. https://matrix.example.com
MATRIX_HS_PUBLIC_BASEURL=         # OPTIONAL

# ── Persistence ───────────────────────────────────────────────────────────
# Directory for append-only journals. UNSET = pure in-memory (lost on restart).
MATRIX_HS_DATA_DIR=               # OPTIONAL, default unset (in-memory)

# ── Garbage collection ─────────────────────────────────────────────────────
# Two caps with very different consequences. Both default to unlimited.
#
# TIMELINE cap — bounds the in-memory /sync + /messages projection only. Trimming
# it shortens how far clients can scroll back on THIS node; the events themselves
# stay in the log and on disk, and a restart brings them back into view.
MATRIX_HS_TIMELINE_MAX_EVENTS=    # OPTIONAL, default unset (unlimited)
#
# ROOMLOG cap — bounds the CRDT set itself, which is the thing that actually grows
# without limit. Exceeding it raises a per-room depth watermark: the old events are
# dropped here, pruned from the journal, and the watermark PROPAGATES — peers adopt
# it from the next delta and drop them too. That propagation is what makes deletion
# converge on a grow-only set instead of bouncing back from whichever peer had not
# collected yet, and it is also what makes this irreversible and cluster-wide: after
# a cut, nobody can page back past it anywhere. Leave at 0 unless growth is a real
# problem. Does not touch room_state (current membership/power_levels) or media.
MATRIX_HS_ROOMLOG_MAX_EVENTS=     # OPTIONAL, default unset (unlimited)

# ── Disk I/O (profiling 2026-08-22; the weak household node was the trigger) ─
# Default (unset/0): fsync EVERY appended journal line — max durability, the
# only copy of an accepted event on a single-node deployment. >0: batch syncs
# with this many ms between them; a power loss may drop the last N ms of
# events. Measured: per-event fsync costs ~9 KB physical writes per ~250 B
# event on ext4 — the dominant ingest cost on a slow disk.
MATRIX_HS_PERSIST_FSYNC_INTERVAL_MS= # OPTIONAL, default 0 (fsync every line)

# ── Agent socket (application service, AGENT-USE-CASES Case 2) ──────────────
# Off unless MATRIX_HS_AS_TOKEN is set. A holder of the token can:
#   POST /register  (Bearer <token>)           → create users under the prefix,
#                                                 no UIA, one call, token returned
#   POST /login     type=m.login.application_service (+ Bearer <token>, user_id,
#                   optional device_id)        → passwordless per-device session
# This is the fleet/agent surface: one MXID per tenant, workers as devices;
# a worker dying is just it stopping syncing. AS accounts have NO usable
# password — the AS token is the only way in. TOKEN IS A SECRET: treat like
# TOKEN_SECRET. Prefix defaults to "as_" when only the token is set.
MATRIX_HS_AS_TOKEN=                    # OPTIONAL, unset = agent socket off
MATRIX_HS_AS_PREFIX=                   # OPTIONAL, e.g. agent_ (default as_)

# ── Scripting (DC++-style Lua hooks) ───────────────────────────────────────
# Directory with .lua scripts (on_room_visible, ...). Missing dir = no-op.
# NOTE: the compiled-in default is ./scripts, relative to the working directory.
# Set this when the server runs from somewhere else.
MATRIX_HS_SCRIPTS_DIR=./scripts  # OPTIONAL, but set on a new server

# ── Media ──────────────────────────────────────────────────────────────────
MATRIX_HS_MEDIA_MAX_BYTES=104857600  # OPTIONAL, ~100 MiB upload cap. In cluster mode
                                     # this also caps what a PEER may hand back on a
                                     # media fetch — an untrusted reply is refused above it.
# Cross-node media fetch budget (CLUSTER). Blobs are pulled on demand, not gossiped,
# so a download for media this node lacks blocks on a mesh query. A client is waiting,
# so keep it short: an unfindable blob should 404, not hang.
MATRIX_HS_MEDIA_FETCH_TIMEOUT_MS=5000

# ── VoIP TURN (optional; only if you run a coturn relay) ───────────────────
# Comma-separated turn:/turns: URIs, the shared auth secret matching coturn's
# static-auth-secret, and credential TTL in seconds.
MATRIX_HS_TURN_URIS=              # OPTIONAL, default unset (no TURN)
MATRIX_HS_TURN_SHARED_SECRET=     # OPTIONAL
MATRIX_HS_TURN_TTL=86400          # OPTIONAL, default 86400

# ── Cluster feature only (cargo build --features cluster) ──────────────────
# Multi-master CRDT replication over Zenoh — the EAST-WEST path (node <-> node).
# With neither CONNECT nor LISTEN set, the server runs in peer/gossip-scouting
# mode (loopback only).
#
# CHOOSING A CARRIER. These two vars are the only thing that selects a transport;
# ZenohCrdtSink is carrier-blind, so every rung below is the same code. Ordered
# by measured survivability, most durable first (see the deployment topology record (kept private)):
#
#   1. LAN peer      leave both empty — zero-config gossip. Dies at a NAT.
#   2. ssh -L        CONNECT=tcp/127.0.0.1:<port>, with autossh forwarding that
#                    local port to the peer. THE DEFAULT for cross-node links:
#                    the traffic rides ssh, nothing plaintext touches the wire.
#   3. obfs / TLS    tls/<host>:<port>, or the AEAD obfs link, under DPI.
#   4. HTTPS         NOT a rung here. The CS-API is north-south (clients) only.
#
# RULE: never put plaintext Zenoh (tcp/<public-ip>:<port>) on a public interface.
# That is a bug, not a rung — and on these paths such ports are filtered anyway.
# RULE: never route replication over the CS-API; it is the least survivable link
# in the system. Full rationale: ARCHITECTURE-boundaries.md, "East-west vs
# north-south".
MATRIX_HS_ZENOH_PREFIX=mrgd/matrix/room   # CLUSTER, default mrgd/matrix/room
MATRIX_HS_ZENOH_CONNECT=                  # CLUSTER, e.g. tcp/127.0.0.1:7449 (ssh tunnel near end)
MATRIX_HS_ZENOH_LISTEN=                   # CLUSTER, e.g. tcp/127.0.0.1:7448 (loopback; tunnel far end)
MATRIX_HS_ZENOH_SCOUTING=                 # CLUSTER, "off" disables multicast+gossip discovery so the
                                          #   only peers are the ones named above. Needed when proving a
                                          #   specific carrier works, and on a host that also runs a node.
                                          #   Default (unset) = on; LAN peer mode depends on it.
MATRIX_HS_ZENOH_MODE=                     # CLUSTER, "client" = zenoh CLIENT mode. Set it whenever the
                                          #   carrier is a ROUTER (e.g. the hubd queue router): peer-mode
                                          #   sessions behind a router relay unreliably BETWEEN each other
                                          #   (measured 2026-08-21: tunnel-client publishes reached the
                                          #   direct client but not the other tunnel client, while queries
                                          #   worked). Default (unset) = peer, which LAN rung 1 needs.
# DPI-resistant carrier (the scope-separation record (kept private) §5): locators may use the obfs scheme,
#   obfs/<host>:<port>#obfs_psk_base64=<base64-32-bytes>   -- note '#', not '?'
# Prefer supplying the key out of band instead, so it stays out of process listings:
BSDOS_OBFS_PSK=                           # base64 32-byte pre-shared key for the obfs transport
MATRIX_HS_BARRIER_KEY=mrgd/coupling/barrier  # CLUSTER, grow-set key prefix
MATRIX_HS_KEYS_PREFIX=                    # CLUSTER, device-key channel prefix
MATRIX_HS_KEYS_PSK=   # CLUSTER, PSK for the device-key channel; set = key announcements encrypted (scope key derived from it), unset = clear (default)
MATRIX_HS_NODE_ID=                        # CLUSTER, default node-<pid> (set for stable identity)

# Node trust anchor (CLUSTER, internal-task). Node signing keys are distributed over an
# UNAUTHENTICATED announcement channel, so under the default TOFU whoever announces
# a node_id first owns it, and a race-claimed key looks exactly like the real one.
# Setting this pins the keys and CLOSES the set: an announcement from any node_id
# not listed here is refused rather than learned.
# Format: node_id=<64 hex chars>,node_id=<64 hex chars>
# A malformed value fails CLOSED — no peer keys are trusted at all until it is
# fixed — because a broken allow-list must not silently become no allow-list.
# Unset = TOFU, the dev default.
MATRIX_HS_NODE_KEYS=                      # CLUSTER, default unset (TOFU)

# Startup catch-up readiness. A node asks peers for every room they have before
# it starts serving. Asking too early gets nothing back, so startup waits for the
# mesh: for a peer to connect, and for that peer's SIGNING KEY to arrive (without
# it, caught-up events fail verification and are dropped — the room converges but
# comes up empty). Key announcements re-publish every 5 s, so the key wait must
# span more than one tick.
# Cost: these are worst cases, and they delay the HTTP listener. A single node
# with no peers pays only the peer wait; set it to 0 to skip waiting entirely.
MATRIX_HS_CATCHUP_PEER_WAIT_MS=3000       # CLUSTER, give up if no peer appears (0 = no wait)
MATRIX_HS_CATCHUP_KEY_WAIT_MS=12000       # CLUSTER, peer connected but key not yet announced

# Mid-life re-query. Catch-up above runs once at startup; a node that is already
# up when a partition heals would otherwise never recover what it missed, since
# Zenoh does not replay to subscribers that were absent. So a background pass
# re-asks: whenever the peer set grows (a peer reappearing is what a healed
# partition looks like from here), and on a slow timer (a link can drop samples
# without the transport dropping, which fires no peer event).
# Repeating is cheap in correctness terms — a pass adds no duplicate events — but
# it does re-transfer each room's log, so the timer is the knob to watch on a
# large or slow deployment.
MATRIX_HS_CATCHUP_INTERVAL_SECS=300       # CLUSTER, backstop re-query period (0 = peer-triggered only)
MATRIX_HS_CATCHUP_SETTLE_MS=6000          # CLUSTER, pause after a peer appears, so its
                                          # signing key (5 s republish) lands before we ask

# ── hubd queue bridge ──────────────────────────────────────────────────────
# Mirrors hubd's per-host queue files onto well-known Matrix rooms, so a queue
# entry replicates over the substrate (signed, catch-up after an outage, GC)
# instead of over a bespoke pub/sub with no replay. Unset = the whole feature is
# a no-op; nothing is read and nothing is written.
#
# Point it at hubd's queues/ directory — the one holding <role>.<node>.queue.md.
# The bridge reads only THIS node's own file and writes only other nodes' files,
# which is what keeps it from feeding itself; see src/hubd_bridge.rs.
# Ingest byte offsets go in a sibling .mxstate/ (next to hubd's .qstate/), never
# inside queues/, which hubd's mesh-sync commits.
MATRIX_HS_HUBD_QUEUES_DIR=        # e.g. ~/.hubd/queues (unset = bridge off)
MATRIX_HS_HUBD_NODE=              # this host's hubd node name; default:
                                  # HUBD_QUEUE_NODE_ID, else /etc/hostname.
                                  # MUST match the <node> segment hubd writes, or
                                  # the bridge ingests nothing and mirrors your own
                                  # queue back at you under a second name.
MATRIX_HS_HUBD_POLL_MS=1000       # OPTIONAL, queue-file poll interval
MATRIX_HS_HUBD_HUB_DIR=           # e.g. ~/.hubd (unset = hub-replic off).
                                  # Replicates the hub (journals, task event
                                  # logs, project/resource cards, sections.json)
                                  # over the mesh instead of git mesh-sync.
                                  # Node name from MATRIX_HS_HUBD_NODE (above).
                                  # Per-file cursors live in .mxstate/ inside
                                  # the hub dir — add .mxstate/ to the hub's
                                  # .gitignore, git mesh-sync must not see it.

# ── mrgd substrate ─────────────────────────────────────────────────────────
# Propagated node id for observability events (set by matrix-hs from NODE_ID).
MRGD_NODE_ID=                     # normally set by matrix-hs, not directly
MRGD_OBSERV=0                     # OPTIONAL, 1 enables observ event emission
